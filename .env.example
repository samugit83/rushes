# Two keys, and both are about the voice.
#
# A credential the FILMED APPLICATION needs never goes here. It is either an
# ambient ${VAR} named by rushes.config.json and exported by you, or a browser
# state file you captured with `rushes login`. There is no third option and no
# exception for convenience: `rushes doctor` fails the build if this file grows
# a third key.
#
# Leave both empty to work offline: RUSHES_TTS=local produces correctly-timed
# silent clips for a rehearsal, a CI re-render or a draft cut.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
